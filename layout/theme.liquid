<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}"><title>{{ page_title }}{% if current_tags %} – {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {% render 'css-variables' %}{{ 'base.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'theme.js' | asset_url }}" defer></script><script src="{{ 'predictive-search.js' | asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body><a class="skip-link" href="#MainContent">Skip to content</a>{% sections 'header-group' %}<main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>{% sections 'footer-group' %}</body>
</html>
