<section class="coastal-story"><div class="coastal-story__art">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.image.alt }}{% else %}<div class="coastal-sun" aria-hidden="true"><span>◯</span><span>◯</span></div>{% endif %}</div><div class="coastal-story__copy"><p class="eyebrow">Made for the long way round</p><h2>Good days.<br>Better views.</h2><p>We make expressive eyewear in small, considered runs. Each frame is shaped for all-day comfort and packed in recycled materials—because the best view is one we protect.</p>{% if section.settings.link != blank %}<a href="{{ section.settings.link }}">Discover our story <span aria-hidden="true">→</span></a>{% endif %}</div></section>
{% schema %}{"name":"Coastal story","settings":[{"type":"image_picker","id":"image","label":"Story image"},{"type":"url","id":"link","label":"Story link"}],"presets":[{"name":"Coastal story"}]}{% endschema %}