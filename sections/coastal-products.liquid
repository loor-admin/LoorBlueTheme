<section class="coastal-products container" id="frames" data-product-grid><div class="coastal-heading"><div><p class="eyebrow">The essentials</p><h2>{{ section.settings.heading | escape }}</h2></div><p>Considered shapes, premium materials and full UV protection. Made to go wherever the sun finds you.</p></div><div class="coastal-toolbar"><div class="shape-tabs" role="group" aria-label="Filter by frame shape"><button type="button" class="is-active" data-shape="all" aria-pressed="true">All</button><button type="button" data-shape="rectangle" aria-pressed="false">Rectangle</button><button type="button" data-shape="cat eye" aria-pressed="false">Cat eye</button><button type="button" data-shape="oval" aria-pressed="false">Oval</button><button type="button" data-shape="aviator" aria-pressed="false">Aviator</button></div><label class="coastal-sort">Sort by: <select data-product-sort aria-label="Sort products"><option value="featured">Featured</option><option value="price-ascending">Price: low to high</option><option value="price-descending">Price: high to low</option><option value="title">Name</option></select></label></div><p class="product-count" data-product-count></p><div class="coastal-grid" data-products>{% assign featured_collection = section.settings.collection | default: collections.all %}{% for product in featured_collection.products limit: section.settings.limit %}<div data-product-item data-tags="{{ product.tags | join: ' ' | downcase | escape }} {{ product.type | downcase | escape }}" data-price="{{ product.price }}" data-title="{{ product.title | escape }}" data-index="{{ forloop.index }}">{% render 'product-card', product: product %}</div>{% else %}<p>Choose a collection in the theme editor to feature products here.</p>{% endfor %}</div><p data-empty-products hidden>No frames match this shape.</p></section>
{% schema %}{"name":"Coastal products","settings":[{"type":"text","id":"heading","label":"Heading","default":"Find your frame"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products","min":3,"max":12,"step":1,"default":6}],"presets":[{"name":"Coastal products"}]}{% endschema %}