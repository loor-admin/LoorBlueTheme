<section class="coastal-newsletter"><p class="eyebrow">Postcards from the coast</p><h2>Stay in the sun</h2><p>New drops, good stories and 15% off your first order.</p>{% form 'customer', class: 'coastal-newsletter__form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="Newsletter-{{ section.id }}">Email address</label><input id="Newsletter-{{ section.id }}" type="email" name="contact[email]" placeholder="Email address" required autocomplete="email"><button type="submit" aria-label="Subscribe">→</button>{% if form.posted_successfully? %}<p>Thanks for subscribing.</p>{% endif %}{{ form.errors | default_errors }}{% endform %}</section>
{% schema %}{"name":"Coastal newsletter","settings":[],"presets":[{"name":"Coastal newsletter"}]}{% endschema %}